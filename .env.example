# -----------------------------------------------------------------------------
# EVOLESS PORTFOLIO (HOUSSAM ELMSAFER) — ENVIRONMENT CONFIGURATION
# -----------------------------------------------------------------------------
# Copy this file to .env.local and fill in your actual keys.
# NEVER commit .env.local to Git.

# =============================================================================
# 1. STUDIO CMS AUTHENTICATION
# =============================================================================
# Secret admin PIN used to log into https://evoless.com/studio
CMS_ADMIN_PIN=evoless2027
# Random string used to sign session cookies
CMS_AUTH_SECRET=replace_with_a_random_32_character_string_here

# =============================================================================
# 2. CLOUDFLARE R2 STANDARD STORAGE (100% FREE TIER VIDEO HOSTING)
# =============================================================================
# Cloudflare Account ID (Found in Cloudflare Dashboard URL or Overview)
R2_ACCOUNT_ID=your_cloudflare_account_id_here
# R2 API Access Key ID (Generated under R2 > Manage R2 API Tokens)
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
# R2 API Secret Access Key
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
# Name of your R2 bucket (e.g. evoless-videos)
R2_BUCKET_NAME=evoless-videos
# Optional: custom domain connected to R2 bucket (leave blank for default private signed streaming)
R2_PUBLIC_DOMAIN=
# Optional signing secret for application token verification
R2_SIGNING_SECRET=

# =============================================================================
# 3. LEGACY / PRESERVED BUNNY STREAM KEYS (OPTIONAL FALLBACK)
# =============================================================================
# Kept for backward compatibility if you have existing Bunny videos
BUNNY_STREAM_TOKEN_KEY=
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_CDN_HOSTNAME=

# =============================================================================
# 4. PRODUCTION DOMAIN & SECURITY
# =============================================================================
NEXT_PUBLIC_SITE_URL=https://evoless.com
ALLOWED_VIDEO_ORIGINS=https://evoless.com,https://www.evoless.com
