# -----------------------------------------------------------------------------
# EVOLESS PORTFOLIO (HOUSSAM ELMSAFER) — ENVIRONMENT CONFIGURATION
# -----------------------------------------------------------------------------
# Copy this file to .env.local and replace with your actual keys.
# NEVER commit .env.local to Git.

# =============================================================================
# 1. STUDIO CMS AUTHENTICATION
# =============================================================================
# Secret admin PIN used to log into https://evoless.com/studio
CMS_ADMIN_PIN=evoless2027
# Random string used to sign session cookies
CMS_AUTH_SECRET=replace_with_a_random_32_character_string_here

# =============================================================================
# 2. BUNNY STREAM VIDEO HOSTING (https://bunny.net/stream)
# =============================================================================
# Master security key used by the server to generate signed playback tokens
BUNNY_STREAM_TOKEN_KEY=your_bunny_stream_token_key_here
# Your Bunny Stream Video Library ID
BUNNY_STREAM_LIBRARY_ID=your_bunny_library_id_here

# =============================================================================
# 3. PRODUCTION DOMAIN & METADATA
# =============================================================================
# Used for canonical links, hreflang, OpenGraph images, and sitemap.xml
NEXT_PUBLIC_SITE_URL=https://evoless.com

# =============================================================================
# 4. OPTIONAL HEADLESS SANITY CMS (https://sanity.io)
# =============================================================================
# Leave empty to use the built-in local Studio CMS at /studio
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
